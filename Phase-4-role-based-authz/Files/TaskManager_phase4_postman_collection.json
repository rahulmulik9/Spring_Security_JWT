{
  "info": {
    "name": "Task Manager - Phase 4 (Role-Based Authz)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "taskId",
      "value": "1"
    }
  ],
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "Ajay", "type": "string" },
      { "key": "password", "value": "password123", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Public - Get Public Endpoint (no auth)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/tasks/public",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "public"]
        }
      }
    },
    {
      "name": "Create Task (Ajay - USER)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Buy groceries\",\n  \"description\": \"Milk, eggs, bread\",\n  \"completed\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        }
      }
    },
    {
      "name": "Get Task By Id (Ajay - USER)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        }
      }
    },
    {
      "name": "Update Task (Ajay - USER)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Buy groceries\",\n  \"description\": \"Milk, eggs, bread, butter\",\n  \"completed\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        }
      }
    },
    {
      "name": "Delete Task (Ajay - USER)",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        }
      }
    },
    {
      "name": "Admin - Get All Tasks (Rahul - ADMIN, expect 200)",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "Rahul", "type": "string" },
            { "key": "password", "value": "admin123", "type": "string" }
          ]
        },
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/admin/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "tasks"]
        }
      }
    },
    {
      "name": "Admin - Get All Tasks (Ajay - USER, expect 403)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/admin/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "tasks"]
        }
      }
    },
    {
      "name": "Admin - Get All Tasks (no auth, expect 401)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/admin/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "tasks"]
        }
      }
    }
  ]
}